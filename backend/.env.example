# ─── Enterprise AI Companion — Backend Environment Variables ────────────────────
#
# Copy this file to .env and fill in the required values.
#   cp backend/.env.example backend/.env
#
# NEVER commit backend/.env — it is gitignored.
# ────────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Base URL for the Volvo GenAI Hub APIM gateway (no trailing slash).
# Example: https://api.volvogenaihubqa.volvogroup.net
EAC_APIM_ENDPOINT=https://api.volvogenaihubqa.volvogroup.net

# Azure OpenAI deployment ID (model name as registered in APIM).
EAC_LLM_MODEL_ID=gpt-5.4-mini_gb_2026-03-17

# ── Optional — Auth ───────────────────────────────────────────────────────────

# APIM subscription key. If left blank the backend will start but all LLM calls
# will return 401. Enter the key in the app via Settings → Security instead —
# it is stored in Windows Credential Manager, not here.
# EAC_APIM_SUBSCRIPTION_KEY=

# ── Optional — Storage ────────────────────────────────────────────────────────

# Override the default SQLite database path.
# Default: %APPDATA%\enterprise-ai-companion\eac.db (resolved at runtime)
# EAC_DATABASE_PATH=

# Qdrant host (default: localhost)
# EAC_QDRANT_HOST=localhost

# Qdrant port (default: 6333)
# EAC_QDRANT_PORT=6333

# ── Optional — Graph ──────────────────────────────────────────────────────────

# Knowledge graph provider. Options: sqlite (default), null
# EAC_GRAPH_PROVIDER=sqlite

# ── Optional — Embedding ──────────────────────────────────────────────────────

# BGE-M3 model name passed to fastembed (default: BAAI/bge-m3)
# EAC_EMBEDDING_MODEL=BAAI/bge-m3

# ── Optional — Logging ────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# EAC_LOG_LEVEL=INFO
