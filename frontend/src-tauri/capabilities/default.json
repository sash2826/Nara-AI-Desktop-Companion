{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and orb window",
  "windows": ["main", "orb"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.volvogenaihubqa.volvogroup.net/*" }]
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "dialog:default"
  ]
}
