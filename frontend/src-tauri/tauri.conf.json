{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enterprise AI Companion",
  "version": "0.1.0",
  "identifier": "com.volvogroup.enterprise-ai-companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Document-Management-RAG-Graph-Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Volvo Group",
    "copyright": "Copyright © 2026 Volvo Group. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Enterprise AI knowledge assistant",
    "longDescription": "Enterprise AI Companion — a local-first AI platform that helps you organise, understand, retrieve, and interact with your digital knowledge.",
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "Volvo Group"
      },
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  },
  "plugins": {}
}
