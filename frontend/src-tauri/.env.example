# Azure AD (Entra ID) configuration for Nara SSO.
# Copy this file to .env (gitignored) and fill in values from your App Registration.
#
# How to get these values:
#   1. Complete the SNOW App Registration process (VG-A-<APIMID>-VTAF-<API NAME>-<ENV>).
#   2. Request Admin Consent.
#   3. Find the values in Entra ID portal → App Registrations → your app.
#
# TENANT_ID:  Directory (tenant) ID — a UUID like xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# CLIENT_ID:  Application (client) ID — a UUID from the App Registration overview
# SCOPE:      The scope to request. For APIM/OpenAI delegation:
#             api://<target-app-client-id>/.default
#             (or a space-separated list for additional scopes like "openid profile")

VITE_AZURE_TENANT_ID=<your-tenant-id>
VITE_AZURE_CLIENT_ID=<your-client-id>
VITE_AZURE_SCOPE=<your-scope>
